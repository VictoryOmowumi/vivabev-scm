<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Security pin: EF Core SQL Server 10.0.14 pulls in Microsoft.Data.SqlClient 6.1.7, which depends on
    System.Security.Cryptography.Pkcs 9.0.11 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx).
    Referencing the patched version directly overrides it. Remove once EF Core ships a fixed SqlClient.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>