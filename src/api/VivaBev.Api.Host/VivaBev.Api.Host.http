@host = http://localhost:5103

### 1. Sign in as the requester (IT department)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "requester@vivabev.example", "password": "Demo@2026!" }

### 2. Find IT's cost centres and the head office site
GET {{host}}/api/organisation/departments

###
GET {{host}}/api/organisation/sites?type=office

### 3. Find the laptop item and the training category
GET {{host}}/api/catalogue/items?search=laptop

###
GET {{host}}/api/catalogue/categories

###
@itOps = 01a18d44-94a6-7041-86f4-4e0a2f875c21
@finAcc = 01a18d44-94a6-7331-a257-69d10c617ed6
@hq = 01a18d44-94ca-720c-bead-c3d818e4a1d3
@laptop = 01a18cef-026f-76d4-94cc-d005a84024d3
@training = 01a18cef-01df-7c8d-9831-9e58a476ce04

### 4. Another department's cost centre: expect 400
POST {{host}}/api/requisitions
Content-Type: application/json

{ "title": "Laptops", "justification": "New analysts", "costCentreId": "{{finAcc}}",
  "deliverToSiteId": "{{hq}}", "requiredBy": "2026-12-15" }

### 5. Your own cost centre: expect 201 with a REQ-2027-xxxxx number
# @name create
POST {{host}}/api/requisitions
Content-Type: application/json

{ "title": "Laptops for new analysts", "justification": "Three analysts join in November",
  "costCentreId": "{{itOps}}", "deliverToSiteId": "{{hq}}", "requiredBy": "2026-12-15" }

###
@req = {{create.response.body.id}}

### 6. A catalogue line: type, unit and description come from the item
POST {{host}}/api/requisitions/{{req}}/lines
Content-Type: application/json

{ "itemId": "{{laptop}}", "quantity": 3, "estimatedUnitPrice": 850000 }

### 7. A free-text service line
POST {{host}}/api/requisitions/{{req}}/lines
Content-Type: application/json

{ "description": "Onboarding training, 2 days", "categoryId": "{{training}}", "lineType": "service",
  "uomCode": "DAY", "quantity": 2, "estimatedUnitPrice": 150000 }

### 8. Read it back: total 2,850,000 NGN
GET {{host}}/api/requisitions/{{req}}

### 9. Submit, then try to add a line: expect 400
POST {{host}}/api/requisitions/{{req}}/submit

###
POST {{host}}/api/requisitions/{{req}}/lines
Content-Type: application/json

{ "itemId": "{{laptop}}", "quantity": 1, "estimatedUnitPrice": 850000 }

### 10. Sign in as the manager: they can't touch someone else's requisition (403)
POST {{host}}/api/auth/logout

###
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "manager@vivabev.example", "password": "Demo@2026!" }

###
POST {{host}}/api/requisitions/{{req}}/cancel
Content-Type: application/json

{ "reason": "Not mine to cancel" }

### 11. The manager's list is empty: no view-all permission, so only their own rows
GET {{host}}/api/requisitions

### 12. The buyer sees everyone's
POST {{host}}/api/auth/logout

###
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "buyer@vivabev.example", "password": "Demo@2026!" }

###
GET {{host}}/api/requisitions

#####################################################################
# Approvals walkthrough
#####################################################################

### ---------- As Chinedu, the requester ----------
POST {{host}}/api/auth/logout

###
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "requester@vivabev.example", "password": "Demo@2026!" }

### A small requisition: 3 laptops, ₦2,550,000
# @name small
POST {{host}}/api/requisitions
Content-Type: application/json

{ "title": "Laptops for new analysts", "justification": "Three analysts join in November",
  "costCentreId": "{{itOps}}", "deliverToSiteId": "{{hq}}", "requiredBy": "2026-12-15" }

###
POST {{host}}/api/requisitions/{{small.response.body.id}}/lines
Content-Type: application/json

{ "itemId": "{{laptop}}", "quantity": 3, "estimatedUnitPrice": 850000 }

###
POST {{host}}/api/requisitions/{{small.response.body.id}}/submit

### Its approval chain: one step, Funmi
# @name smallTrail
GET {{host}}/api/approvals/documents/Requisition/{{small.response.body.id}}

### Chinedu can't approve: expect 403
POST {{host}}/api/approvals/{{smallTrail.response.body.requestId}}/approve
Content-Type: application/json

{ "comment": "Approving my own request" }

### A large requisition: 40 laptops, ₦34,000,000
# @name large
POST {{host}}/api/requisitions
Content-Type: application/json

{ "title": "Laptop refresh for IT", "justification": "Replace 40 laptops past warranty",
  "costCentreId": "{{itOps}}", "deliverToSiteId": "{{hq}}", "requiredBy": "2027-01-31" }

###
POST {{host}}/api/requisitions/{{large.response.body.id}}/lines
Content-Type: application/json

{ "itemId": "{{laptop}}", "quantity": 40, "estimatedUnitPrice": 850000 }

###
POST {{host}}/api/requisitions/{{large.response.body.id}}/submit

### Two steps: Funmi (line manager, also head of department) then the Managing Director
# @name largeTrail
GET {{host}}/api/approvals/documents/Requisition/{{large.response.body.id}}

### ---------- As Funmi, Head of IT ----------
POST {{host}}/api/auth/logout

###
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "manager@vivabev.example", "password": "Demo@2026!" }

### Her inbox: both requisitions
GET {{host}}/api/approvals/inbox

### She can open a requisition she's approving (no view-all permission needed)
GET {{host}}/api/requisitions/{{small.response.body.id}}

### Approve both
POST {{host}}/api/approvals/{{smallTrail.response.body.requestId}}/approve
Content-Type: application/json

{ "comment": "Approved" }

###
POST {{host}}/api/approvals/{{largeTrail.response.body.requestId}}/approve
Content-Type: application/json

{ "comment": "Needed, but check the quantity" }

### ---------- As the Managing Director ----------
POST {{host}}/api/auth/logout

###
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "md@vivabev.example", "password": "Demo@2026!" }

###
GET {{host}}/api/approvals/inbox

### Reject without a reason: expect 400
POST {{host}}/api/approvals/{{largeTrail.response.body.requestId}}/reject
Content-Type: application/json

{ }

### Reject with a reason
POST {{host}}/api/approvals/{{largeTrail.response.body.requestId}}/reject
Content-Type: application/json

{ "comment": "Replace 10 now and 30 next fiscal year" }

### ---------- Back as Chinedu ----------
POST {{host}}/api/auth/logout

###
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "requester@vivabev.example", "password": "Demo@2026!" }

### Small: Approved. Large: Draft, with the MD's reason
GET {{host}}/api/requisitions/{{small.response.body.id}}

###
GET {{host}}/api/requisitions/{{large.response.body.id}}

### Fix it: 10 laptops instead of 40 (₦8,500,000), and resubmit
DELETE {{host}}/api/requisitions/{{large.response.body.id}}/lines/1

###
POST {{host}}/api/requisitions/{{large.response.body.id}}/lines
Content-Type: application/json

{ "itemId": "{{laptop}}", "quantity": 10, "estimatedUnitPrice": 850000 }

###
POST {{host}}/api/requisitions/{{large.response.body.id}}/submit

### Now one step: the policy adds head of department above ₦5m, but that's Funmi again, so she appears once
GET {{host}}/api/approvals/documents/Requisition/{{large.response.body.id}}

